{
  "name": "@orly/directory-client",
  "version": "0.1.0",
  "description": "TypeScript client library for Nostr Distributed Directory Consensus Protocol",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
